{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Zoho Analytics expects the CONFIG value of a GET request to be URL encoded.",
          "// Postman keeps query values verbatim, so encode them here, once, for every GET.",
          "if (pm.request.method === 'GET') {",
          "    const count = pm.request.url.query.count();",
          "    for (let i = 0; i < count; i++) {",
          "        const param = pm.request.url.query.idx(i);",
          "        if (param.value && param.value === decodeURIComponent(param.value)) {",
          "            param.value = encodeURIComponent(param.value);",
          "        }",
          "    }",
          "}",
          ""
        ],
        "type": "text/javascript"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access-token}}",
        "type": "string"
      }
    ]
  },
  "info_schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
}